DATABASE_URL=            # Tiger Data connection string (local: postgres://localhost:5432/wsp)
NESSIE_API_KEY=          # Capital One Nessie
SERPAPI_KEY=
GEMINI_API_KEY=         # Google AI Studio key (server only)
GEMINI_MODEL=gemini-3.8-flash   # optional; check https://ai.google.dev/gemini-api/docs/models for what your key can use
SESSION_SECRET=
USE_MOCKS=true           # forces mock Nessie, SerpApi, Gemini
